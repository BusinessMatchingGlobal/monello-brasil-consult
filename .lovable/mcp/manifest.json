{
  "version": 1,
  "sdk_version": "0.28.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "businessmatching-global",
      "version": "0.1.0",
      "title": "businessmatching.global"
    },
    "tools": [
      {
        "name": "search_brazil_knowledge",
        "title": "Search Brazil/Europe knowledge base",
        "description": "Search the Business Matching Global research archive — published #CustoEuropa analyses AND the full text of the BMG ebooks, operational manuals and dossiers (Exporting to Brazil, Brazil health/pharma market, EUDR, machinery & SACE/SIMEST, Ajvar dossier) — on Brazil–Europe trade, regulation, import/export and market access. Returns the most relevant excerpts with source URLs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "The question or keywords to search for."
            },
            "language": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "it",
                    "en",
                    "pt"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Preferred content language: it, en or pt. Null searches all languages."
            },
            "limit": {
              "type": [
                "number",
                "null"
              ],
              "description": "Maximum number of results (default 5)."
            }
          },
          "required": [
            "query",
            "language",
            "limit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_articles",
        "title": "List published analyses",
        "description": "List the published Business Matching Global analyses (#CustoEuropa) with title, date, language and URL, most recent first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "language": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "it",
                    "en",
                    "pt"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by language: it, en or pt. Null returns all languages."
            },
            "limit": {
              "type": [
                "number",
                "null"
              ],
              "description": "Maximum number of articles (default 20)."
            }
          },
          "required": [
            "language",
            "limit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_article",
        "title": "Read a published analysis or ebook",
        "description": "Return the full text of one published Business Matching Global document — an analysis (e.g. 'pix', 'bahia', 'amapa') or an ebook/guide/dossier (e.g. 'guide-exporting-to-brazil', 'guide-brazil-health-market', 'guide-eudr', 'guide-macchinari-brasile', 'dossier-ajvar'). Long ebooks are returned in parts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "description": "Article slug, as returned by list_articles or search_brazil_knowledge."
            },
            "language": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "it",
                    "en",
                    "pt"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Language of the version to read. Null picks the first available."
            },
            "part": {
              "type": [
                "number",
                "null"
              ],
              "description": "For long ebooks: 1-based part to read (each part is ~18000 characters). Null = part 1."
            }
          },
          "required": [
            "slug",
            "language",
            "part"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_guides",
        "title": "List BMG guides and reports",
        "description": "List the practical guides, ebooks and sample reports published by Business Matching Global (exporting to Brazil, machinery & SACE/SIMEST, pharma/ANVISA, EUDR, doing business in Brazil), with topics, download URLs and — where available — the slug to read the full text with get_article.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "topic": {
              "type": [
                "string",
                "null"
              ],
              "description": "Optional keyword to filter guides by topic."
            }
          },
          "required": [
            "topic"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_services",
        "title": "List Business Matching Global services",
        "description": "List the services Business Matching Global offers (market research, company verification, buyer/supplier search, business matching, import/export support, business travel), with what each includes, who it is for and the starting price.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "language": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "it",
                    "en",
                    "pt"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Catalogue language (default en)."
            },
            "query": {
              "type": [
                "string",
                "null"
              ],
              "description": "Optional keyword to filter services by name or description."
            }
          },
          "required": [
            "language",
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_company_info",
        "title": "Business Matching Global — company & contacts",
        "description": "Return who Business Matching Global is, what it does, the markets it covers, contact details and the main pages of the website (services, analyses, guides, business travel).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "qualify_company",
        "title": "Qualify a company and suggest the right BMG service",
        "description": "Collect the profile of a company interested in the Brazil–Europe corridor (sector, country, objective, stage, timing) and return a structured qualification plus the Business Matching Global service that fits best, with its starting price. Read-only: it does not create a lead — call request_consultation for that.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "company_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Company name, if known."
            },
            "country": {
              "type": [
                "string",
                "null"
              ],
              "description": "Country where the company is based."
            },
            "sector": {
              "type": [
                "string",
                "null"
              ],
              "description": "Sector / products or services."
            },
            "objective": {
              "type": [
                "string",
                "null"
              ],
              "description": "What the company wants to achieve (export to Brazil, find buyers, verify a partner, import, market study...)."
            },
            "stage": {
              "type": [
                "string",
                "null"
              ],
              "description": "Current stage: exploring, already exporting, has a counterpart to verify, etc."
            },
            "timing": {
              "type": [
                "string",
                "null"
              ],
              "description": "Timeframe or urgency, if known."
            },
            "language": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "it",
                    "en",
                    "pt"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Answer language (default en)."
            }
          },
          "required": [
            "company_name",
            "country",
            "sector",
            "objective",
            "stage",
            "timing",
            "language"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "request_consultation",
        "title": "Send a consultation request to Business Matching Global",
        "description": "Create a contact request for Business Matching Global on behalf of a company. Only call it after the user has explicitly asked to be contacted and has provided a real email address. Returns a confirmation; BMG replies by email.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "format": "email",
              "description": "Email address BMG should reply to (required, provided by the user)."
            },
            "contact_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Name of the person to contact."
            },
            "company_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Company name."
            },
            "country": {
              "type": [
                "string",
                "null"
              ],
              "description": "Country where the company is based."
            },
            "sector": {
              "type": [
                "string",
                "null"
              ],
              "description": "Sector / products or services."
            },
            "goal": {
              "type": [
                "string",
                "null"
              ],
              "description": "What the company wants to achieve."
            },
            "service": {
              "type": [
                "string",
                "null"
              ],
              "description": "Service of interest, e.g. the one suggested by qualify_company."
            },
            "message": {
              "type": [
                "string",
                "null"
              ],
              "description": "Free-text message or context for BMG."
            },
            "language": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "it",
                    "en",
                    "pt",
                    "es"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Preferred reply language."
            }
          },
          "required": [
            "email",
            "contact_name",
            "company_name",
            "country",
            "sector",
            "goal",
            "service",
            "message",
            "language"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
